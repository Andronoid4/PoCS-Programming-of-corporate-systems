@model IEnumerable<TravelGuide.Models.City>

@{
    ViewData["Title"] = "Список городов";
}

<div class="container mt-4">
    <h1 class="mb-4">Туристический путеводитель</h1>
    
    <!-- Поиск -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Поиск по названию города..." value="@Context.Request.Query["searchString"]" />
            <button type="submit" class="btn btn-primary">Найти</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </div>
    </form>

    <!-- Список городов -->
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var city in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@city.PhotoUrl" class="card-img-top" alt="@city.Name" style="height: 200px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/400x200?text=No+Image'" />
                        <div class="card-body">
                            <h5 class="card-title">@city.Name</h5>
                            <p class="card-text"><strong>Регион:</strong> @city.Region</p>
                            <p class="card-text"><strong>Население:</strong> @city.Population.ToString("N0") чел.</p>
                            <p class="card-text">@city.History.Substring(0, Math.Min(100, city.History.Length))...</p>
                            <a asp-action="Details" asp-route-id="@city.Id" class="btn btn-primary">Подробнее</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">Города не найдены</div>
            </div>
        }
    </div>
</div>
